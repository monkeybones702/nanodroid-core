#!/usr/bin/env bash
WATCHDOG_SCRIPT="$HOME/nanodroid_watchdog.py"
SCHEDULER_SCRIPT="$HOME/nanodroid_scheduler.py"
UPDATER_SCRIPT="$HOME/nanodroid_updater.py"
HUB_SCRIPT="$HOME/nanodroid_ws_hub.py"
QUEUE_SCRIPT="$HOME/nanodroid_queue.py"
NAVIGATOR_SCRIPT="$HOME/nanodroid_ui_navigator.py"
MACRO_SCRIPT="$HOME/nanodroid_macro.py"
AGENT_SCRIPT="$HOME/nanodroid_agent.py"
TERMINATE_SCRIPT="$HOME/nanodroid_terminate.py"
GIT_SYNC_SCRIPT="$HOME/nanodroid_git_sync.py"
PID_FILE="$HOME/.nanodroid_hub.pid"
LOG_FILE="$HOME/.nanodroid_master.log"

case "$1" in
    start)
        python3 "$UPDATER_SCRIPT" snapshot
        python3 "$WATCHDOG_SCRIPT" start
        python3 "$SCHEDULER_SCRIPT" start
        
        if [ ! -f "$PID_FILE" ]; then
            echo "[*] Starting NanoDroid Full Ecosystem at http://127.0.0.1:8000..."
            nohup python3 "$HUB_SCRIPT" > "$LOG_FILE" 2>&1 &
            echo $! > "$PID_FILE"
        fi
        echo "[+] NanoDroid-Core Full Ecosystem ONLINE."
        ;;
    stop|terminate)
        python3 "$TERMINATE_SCRIPT"
        ;;
    restart)
        "$0" terminate
        sleep 1
        "$0" start
        ;;
    status)
        python3 "$WATCHDOG_SCRIPT" status
        if [ -f "$PID_FILE" ] && ps -p $(cat "$PID_FILE") > /dev/null 2>&1; then
            echo " * Ecosystem Hub Status: ONLINE (PID: $(cat "$PID_FILE"))"
        else
            echo " * Ecosystem Hub Status: OFFLINE"
        fi
        ;;
    sync)
        python3 "$GIT_SYNC_SCRIPT" "$2"
        ;;
    agent)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl agent '<natural_language_goal>'"
            exit 1
        fi
        python3 "$AGENT_SCRIPT" "$2"
        ;;
    ui-tap)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl ui-tap '<button_text_or_id>'"
            exit 1
        fi
        python3 "$NAVIGATOR_SCRIPT" tap "$2"
        ;;
    ui-type)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: nanodroidctl ui-type '<field_query>' '<text>'"
            exit 1
        fi
        python3 "$NAV_ шаг" type "$2" "$3" 2>/dev/null || python3 "$NAVIGATOR_SCRIPT" type "$2" "$3"
        ;;
    macro-record)
        if [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
            echo "Usage: nanodroidctl macro-record <macro_name> <x_coord> <y_coord>"
            exit 1
        fi
        python3 "$MACRO_SCRIPT" record-tap "$2" "$3" "$4"
        ;;
    macro-replay)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl macro-replay <macro_name>"
            exit 1
        fi
        python3 "$MACRO_SCRIPT" replay "$2"
        ;;
    enqueue)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: nanodroidctl enqueue <type> '<payload>' [priority]"
            exit 1
        fi
        python3 "$QUEUE_SCRIPT" add "$2" "$3" "${4:-5}"
        ;;
    clean)
        python3 "$WATCHDOG_SCRIPT" clean
        ;;
    watch)
        python3 "$WATCHDOG_SCRIPT" watch
        ;;
    snapshot)
        python3 "$UPDATER_SCRIPT" snapshot
        ;;
    logs)
        if [ -f "$LOG_FILE" ]; then
            tail -n 50 -f "$LOG_FILE"
        else
            echo "[-] No master log file found."
        fi
        ;;
    *)
        echo "NanoDroid-Core Supervisor (v17.1.0)"
        echo "Usage: nanodroidctl {start|stop|terminate|restart|status|sync [git_url]|agent|ui-tap|ui-type|macro-record|macro-replay|enqueue|clean|watch|snapshot|logs}"
        exit 1
        ;;
esac
