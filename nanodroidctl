#!/usr/bin/env bash
EXECUTIVE_SCRIPT="$HOME/nanodroid_executive.py"
ONLINE_LLM_SCRIPT="$HOME/nanodroid_online_llm.py"
SHIZUKU_BRIDGE="$HOME/nanodroid_shizuku_bridge.py"
VISION_ENGINE="$HOME/nanodroid_vision.py"
OPTIMIZER_SCRIPT="$HOME/nanodroid_optimizer.py"
GIT_SYNC_SCRIPT="$HOME/nanodroid_git_sync.py"

case "$1" in
    api-key)
        python3 "$ONLINE_LLM_SCRIPT" key "$2"
        ;;
    cloud-exec|cloud)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl cloud '<goal>'"
            exit 1
        fi
        PLAN=$(python3 "$ONLINE_LLM_SCRIPT" plan "$2")
        echo "[+] Cloud Plan Result: $PLAN"
        ;;
    exec|do)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl exec '<natural_language_goal>'"
            exit 1
        fi
        START_TIME=$(date +%s%N)
        python3 "$EXECUTIVE_SCRIPT" "$2"
        EXIT_CODE=$?
        END_TIME=$(date +%s%N)
        LATENCY_MS=$(( (END_TIME - START_TIME) / 1000000 ))
        python3 "$OPTIMIZER_SCRIPT" log "$2" "exec" $( [ $EXIT_CODE -eq 0 ] && echo 1 || echo 0 ) "$LATENCY_MS"
        ;;
    ui)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl ui dump | click '<text>'"
            exit 1
        fi
        python3 "$SHIZUKU_BRIDGE" "$2" "${@:3}"
        ;;
    vision|heal)
        if [ -z "$2" ]; then
            echo "Usage: nanodroidctl vision '<target_text_or_resource_id>'"
            exit 1
        fi
        python3 "$VISION_ENGINE" "${@:2}"
        ;;
    optimize|evolve)
        python3 "$OPTIMIZER_SCRIPT"
        ;;
    sync|push)
        python3 "$GIT_SYNC_SCRIPT"
        ;;
    status)
        rish -c "getprop ro.product.model"
        ;;
    *)
        echo "NanoDroid-Core Controller (v28.0.0)"
        echo "Usage: nanodroidctl sync | nanodroidctl exec '<goal>' | nanodroidctl optimize"
        exit 1
        ;;
esac
